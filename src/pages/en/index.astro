---
import GitHubIcon from "../../components/icons/GitHubIcon.astro";
import LinkedinIcon from "../../components/icons/LinkedinIcon.astro";
import SocialButtons from "../../components//SocialButtons.astro";
import Layout from "../../layouts/Layout.astro";
import SectionContainer from "../../components/SectionContainer.astro";
import Projects from "../../components/Projects.astro";
import AnimatedIcon from "../../components/AnimatedIcon.astro";
import { icons } from "../../utils/icons.astro";
import Contact from "../../components/Contact.astro";
import MessageIcon from "../../components/icons/MessageIcon.astro";
---

<Layout>
	<main class="container mx-auto px-4 py-4 md:px-10 lg:px-22" id="inicio">
		<SectionContainer
			id="sobremi"
			class="grid md:grid-cols-[2fr_minmax(300px,400px)] justify-between gap-5 md:gap-10"
		>
			<div class="order-2 md:order-1 flex flex-col justify-center gap-y-2">
				<h1 class="text-2xl sm:text-2xl lg:text-4xl font-bold select-none">Agustin Moreira</h1>
				<h3 class="text-base sm:text-lg lg:text-xl select-none">Full-Stack Web Developer</h3>
				<p class=" text-sm sm:text-base lg:text-lg select-none">
					Computer Engineering graduate specializing in Full Stack web
					development. I enjoy building applications and platforms,
					working across front-end, back-end, and database
					technologies to create functional, scalable, and
					user-focused solutions. I strive to write clean,
					maintainable code while following software development best
					practices, with a strong focus on innovation, efficiency and
					continuous improvement.
				</p>
				<div class="flex flex-col sm:flex-row mt-2 gap-4">
					<SocialButtons>
						<MessageIcon class="size-4 sm:size-5 lg:size-6" />
						<span class="text-xs sm:text-sm lg:text-base font-semibold">azugmoreira@gmail.com</span>
					</SocialButtons>
					<SocialButtons href="https://github.com/Azxgo">
						<GitHubIcon class="size-4 sm:size-5 lg:size-6" />
						<span class="text-xs sm:text-sm lg:text-base font-semibold">GitHub</span>
					</SocialButtons>
					<SocialButtons
						href="https://www.linkedin.com/in/agustinmoreirat/"
					>
						<LinkedinIcon class="size-4 sm:size-5 lg:size-6" />
						<span class="text-xs sm:text-sm lg:text-base font-semibold">Linkedin</span>
					</SocialButtons>
				</div>
			</div>

			<div class="order-1 md:order-2 md:justify-self-end">
				<div class="relative w-fit">
					<div
						class="absolute inset-0 translate-x-4 translate-y-4 rounded-3xl bg-zinc-800/30"
					>
					</div>

					<div
						class="relative overflow-hidden rounded-3xl shadow-2xl ring-1 ring-white/10"
					>
						<div
							class="absolute inset-0 bg-gradient-to-tr from-indigo-600/20 via-transparent to-indigo-800/40 z-10"
						>
						</div>

						<img
							src="/img/img1.JPEG"
							alt="Agustín Moreira"
							class="w-full max-w-[340px] h-auto object-cover"
						/>
					</div>
				</div>
			</div>
		</SectionContainer>

		<SectionContainer
			class="flex flex-col mt-10 justify-center items-center gap-y-3"
		>
			<h2 class="text-xl sm:text-2xl lg:text-3xl mb-4 tracking-widest select-none">SKILLS</h2>

			<ul class="flex flex-wrap justify-center items-center gap-2 sm:gap-6">
				{
					icons.map(({ icon: Icon, label }) => (
						<AnimatedIcon label={label}>
							<Icon class="size-6 sm:size-12 lg:size-16" />
						</AnimatedIcon>
					))
				}
			</ul>
		</SectionContainer>

		<SectionContainer
			id="proyectos"
			class="flex flex-col justify-center items-center"
		>
			<h2 class="text-xl sm:text-2xl lg:text-3xl mb-10 tracking-widest select-none">PROJECTS</h2>

			<Projects lang="en" />
			<p class="text-xs sm:text-sm lg:text-base text-gray-400 mt-4">
				*If any of the sites do not load immediately, it may be because
				their servers are starting up. In that case, please refresh the
				page.
			</p>
		</SectionContainer>

		<SectionContainer
			id="contacto"
			class="flex flex-col justify-center items-center"
		>
			<h2 class="text-xl sm:text-2xl lg:text-3xl mb-10 tracking-widest select-none">CONTACT</h2>

			<Contact lang="en" />
		</SectionContainer>
	</main>
</Layout>
