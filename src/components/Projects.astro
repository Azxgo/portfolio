---
import ProjectsButtons from "../components/ProjectsButtons.astro";
import { ImageGallery } from "./ImageGallery";

const { lang = "es" } = Astro.props as {
    lang?: "es" | "en";
}; 

const PROJECTS = [
    {
        icon: "./projects/asislablogo.png",
        title: "ASISLAB",
        description: {
            es: `Demo de una plataforma centrada en la creación, impartición y ánalisis de capacitaciones preventivas.\n
        La plataforma ofrece un completo sistema para crear presentaciones y cuestionarios asistidos por inteligencia artificial,
        ademas de incorporar graficos, tablas y estadisticas que permiten evaluar el desempeño y el nivel de conocimiento a traves de los participantes.`,
            en: `Demo of a platform focused on creating, delivering, and analyzing workplace safety training.
        It features a complete system for building AI-assisted presentations and quizzes, along with charts, tables, and analytics to evaluate participants performace and knowledge.`,
        },
        link: "https://asislab-demo.vercel.app/",
        github: "https://github.com/Azxgo/asislab-demo-frontend",
        images: [
            "./projects/asislab0.png",
            "./projects/asislab1.png",
            "./projects/asislab2.png",
            "./projects/asislab3.png",
            "./projects/asislab4.png",
            "./projects/asislab5.png",
            "./projects/asislab6.png",
            "./projects/asislab7.png",
            "./projects/asislab8.png",
            "./projects/asislab9.png",
            "./projects/asislab10.png",
        ],
        tags: ["IA", "React", "Python", "Flask", "JS"],
    },
    {
        icon: "./projects/musimp4logo.png",
        title: "musi.mp4",
        description: {
            es: `Mini proyecto que simula un reproductor web. Permite buscar canciones y, al seleccionar una, muestra un reproductor con una vista previa de 30 segundos, controles para pausar la reproducción y avanzar a la siguiente canción recomendada.
        Todas sus funcionalidades se integran con la API de Deezer (servicio de streaming).`,
            en: `A mini web music player that lets users search for songs and instantly play a 30-second preview.
    It includes playback controls and recommends the next related track. All features are powered by the Deezer streaming API`,
        },
        link: "https://musi-mp4.vercel.app/",
        github: "https://github.com/Azxgo/musi.mp4",
        images: [
            "./projects/musimp40.png",
            "./projects/musimp41.png",
            "./projects/musimp42.png",
        ],
        tags: ["JS", "React", "API"],
    },
    {
        icon: "./projects/uniqmarketlogo.png",
        title: "Uniqmarket",
        description: {
            es: `Plataforma de e-commerce para la gestion y venta de productos que no suelen estar en las tiendas comunes\n
        Posee funcionalidades como catalogo dinamico, filtrado basico, autenticacion de usuario, carrito por usuarios y panel de gestion completa de administrador.`,
            en: `E-commerce platform designed for managing and selling products that are not commonly found in traditional stores.
            It includes features such as a dynamic product catalog, filtering, user authentication, shopping cart, and a complete administrative dashboard.`,
        },
        link: "https://uniqmarket.vercel.app/",
        github: "https://github.com/Azxgo/uniqmarket",
        images: [
            "./projects/uniqmarket0.png",
            "./projects/uniqmarket1.png",
            "./projects/uniqmarket2.png",
            "./projects/uniqmarket3.png",
            "./projects/uniqmarket4.png",
            "./projects/uniqmarket5.png",
        ],
        tags: ["JS", "React", "SQL", "NodeJs", "Express"],
    },
];
---

<ul class="grid grid-cols-2 gap-12">
    {
        PROJECTS.map(
            ({ icon, images, title, description, tags, link, github }) => (
                <li
                    class="flex flex-col border border-gray-500
                            hover:border-gray-400 transition duration-300 ease-in-out rounded-lg p-6 gap-y-4"
                >
                    <ImageGallery images={images} client:load />
                    <div class="flex flex-col gap-2 h-full">
                        <div class="flex gap-2 items-center">
                            <img class="w-10 h-10" src={icon} alt="img" />
                            <h1 class="text-3xl font-semibold mb-1">{title}</h1>
                        </div>
                        <p class="text-lg">{description[lang]}</p>
                        <ul class="flex flex-wrap gap-2 mt-3">
                            {tags.map((tag) => (
                                <li
                                    class="px-3 py-1 text-sm font-medium
                                    bg-gray-100 text-gray-700
                                    rounded-full select-none"
                                >
                                    {tag}
                                </li>
                            ))}
                        </ul>
                        <div class="mt-auto">
                            <div class="flex flex-row gap-4 mt-4">
                                <ProjectsButtons href={github}>
                                    Github
                                </ProjectsButtons>
                                <ProjectsButtons href={link}>
                                    Preview
                                </ProjectsButtons>
                            </div>
                        </div>
                    </div>
                </li>
            ),
        )
    }
</ul>
