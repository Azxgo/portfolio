---
const isEnglish = Astro.url.pathname.startsWith("/en");
---

<footer
    class="flex justify-between items-center p-6 bg-zinc-800/10 border-t border-zinc-600"
>
    <nav class="flex flex-row gap-x-10">
        <p class="text-zinc-400 text-xs">© 2026 Agustin Moreira. {isEnglish ? "All rights reserved." : "Todos los derechos reservados"} </p>

        <p class="text-zinc-400 text-xs">
            {isEnglish ? "Some icons are provided by third-party libraries." : "Algunos íconos son proporcionados por bibliotecas de terceros."} 
        </p>
    </nav>
</footer>
